# Copy this file to ".env" and fill in real values. Never commit ".env" to git.

# From Supabase: Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Any long random string - used to sign login sessions (JWT tokens).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# SMS provider for sending OTPs - sign up at msg91.com or twilio.com
SMS_PROVIDER_API_KEY=your-sms-provider-key-here

# KYC provider for verifying Aadhaar/PAN - sign up at digio.in, signzy.com, or setu.co
KYC_PROVIDER_API_KEY=your-kyc-provider-key-here

PORT=3000
